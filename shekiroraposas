<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shekiro Raposas, MIS | Contact</title>
<style>
  :root { --bg:#f6f7f9; --card:#fff; --text:#1a1a1a; --muted:#666; --accent:#2457d6; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#121417; --card:#1c1f24; --text:#f0f0f0; --muted:#9aa0a6; --accent:#7aa2ff; }
  }
  body { margin:0; min-height:100vh; display:grid; place-items:center; background:var(--bg);
         color:var(--text); font-family:system-ui,-apple-system,"Segoe UI",sans-serif; }
  .card { background:var(--card); padding:32px; border-radius:16px; width:min(92vw,380px);
          box-shadow:0 4px 24px rgba(0,0,0,.08); }
  h1 { margin:0 0 4px; font-size:1.4rem; }
  p.sub { margin:0 0 24px; color:var(--muted); }
  a.row { display:block; padding:12px 0; border-top:1px solid rgba(128,128,128,.25);
          color:var(--accent); text-decoration:none; word-break:break-all; }
  a.row small { display:block; color:var(--muted); font-size:.75rem; }
  a.btn { display:block; margin-top:20px; text-align:center; padding:12px; border-radius:10px;
          background:var(--accent); color:#fff; text-decoration:none; font-weight:600; }
</style>
</head>
<body>
  <main class="card">
    <h1>Shekiro Raposas, MIS</h1>
    <p class="sub">Contact details</p>
    <a class="row" href="mailto:shekiro.raposas16001@gmail.com"><small>Email</small>shekiro.raposas16001@gmail.com</a>
    <a class="btn" href="contact.vcf" download>Save to contacts</a>
  </main>
</body>
</html>
